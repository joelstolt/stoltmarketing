{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stoltmarketing",
  "main": "worker-with-headers.mjs",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
